  "Plan_of_Care": [
    {
      "fact_id": "Plan_of_Care-001",
      "content": "Continue Lemsip as needed and avoid other paracetamol products",
      "source_text": "Continue Lemsip PRN; avoid other paracetamol products"
    },
    {
      "fact_id": "Plan_of_Care-002",
      "content": "Maintain hydration and rest",
      "source_text": "Hydration, rest"
    },
    {
      "fact_id": "Plan_of_Care-003",
      "content": "Buy a thermometer and monitor temperature",
      "source_text": "Buy thermometer; monitor T"
    },
    {
      "fact_id": "Plan_of_Care-004",
      "content": "Return or seek care if persistent temperature of 37.5-38 \u00b0C or higher, worsening cough, purulent sputum, haemoptysis or epistaxis, shortness of breath, or chest pain",
      "source_text": "Return/seek care if T \u2265 37.5-38 \u00b0C persistent, worsening cough, purulent sputum, haemoptysis/epistaxis, SOB, chest pain"
    },
    {
      "fact_id": "Plan_of_Care-005",
      "content": "Consider antibiotics if red flag symptoms emerge",
      "source_text": "Consider antibiotics if above red flags emerge"
    },
    {
      "fact_id": "Plan_of_Care-006",
      "content": "Avoid daytime cough syrup; use small dose at night only if sleep is disturbed",
      "source_text": "Avoid daytime cough syrup; small dose nocte only if sleep disturbed"
    },
    {
      "fact_id": "Plan_of_Care-007",
      "content": "Keep routine diabetes and blood pressure reviews with general practitioner",
